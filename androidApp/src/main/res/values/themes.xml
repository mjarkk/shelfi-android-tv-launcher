<resources>
    <color name="shelfi_background">#13241D</color>

    <style name="Theme.Shelfi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shelfi_background</item>
        <item name="android:colorBackground">@color/shelfi_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
